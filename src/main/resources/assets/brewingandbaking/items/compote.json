{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "brewingandbaking:luxury_points",
    "cases": [
      {
        "when": [1, 2],
        "model": { "type": "minecraft:model", "model": "brewingandbaking:item/compote/specked" }
      },
      {
        "when": [3, 4],
        "model": { "type": "minecraft:model", "model": "brewingandbaking:item/compote/dusted" }
      },
      {
        "when": 5,
        "model": { "type": "minecraft:model", "model": "brewingandbaking:item/compote/plated" }
      }
    ],
    "fallback": { "type": "minecraft:model", "model": "brewingandbaking:item/compote" }
  }
}
